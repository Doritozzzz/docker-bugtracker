# Production environment template.
# `make setup-env` copies it to .env.prod and replaces every CHANGE_ME with a
# random secret. Never commit the real .env.prod file.

# --- Web ---
WEB_PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_DB=tracker_prod
POSTGRES_USER=tracker
POSTGRES_PASSWORD=CHANGE_ME

# --- Cache (Redis) ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
REDIS_PASSWORD=CHANGE_ME
