# Development environment template.
# `make setup-env` copies it to .env.dev and replaces every CHANGE_ME with a
# random secret. Never commit the real .env.dev file.

# --- Web ---
WEB_PORT=3000
LOG_LEVEL=debug

# --- PostgreSQL ---
POSTGRES_DB=tracker_dev
POSTGRES_USER=tracker
POSTGRES_PASSWORD=CHANGE_ME

# --- Cache: disabled in dev ---
CACHE_ENABLED=false
